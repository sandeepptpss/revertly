// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "mysql"
  url      = env("DATABASE_URL")
}

model Session {
  id                  String    @id @db.VarChar(255)
  shop                String    @db.VarChar(255)
  state               String    @db.VarChar(255)
  isOnline            Boolean   @default(false)
  scope               String?   @db.Text
  expires             DateTime?
  accessToken         String    @db.Text
  userId              BigInt?
  firstName           String?   @db.VarChar(255)
  lastName            String?   @db.VarChar(255)
  email               String?   @db.VarChar(255)
  accountOwner        Boolean   @default(false)
  locale              String?   @db.VarChar(100)
  collaborator        Boolean?  @default(false)
  emailVerified       Boolean?  @default(false)
  refreshToken        String?   @db.Text
  refreshTokenExpires DateTime?
}

// Stores current snapshot of product data for comparison
model ProductSnapshot {
  id              Int      @id @default(autoincrement())
  shop            String   @db.VarChar(255)
  productId       String   @db.VarChar(255)
  title           String   @db.VarChar(500)
  status          String   @db.VarChar(50)
  vendor          String?  @db.VarChar(255)
  productType     String?  @db.VarChar(255)
  tags            String?  @db.Text
  bodyHtml        String?  @db.LongText
  handle          String?  @db.VarChar(255)
  publishedAt     DateTime?
  snapshotData    Json     // Full JSON snapshot
  isDeleted       Boolean  @default(false)
  deletedAt       DateTime?
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  @@unique([shop, productId])
  @@index([shop])
  @@index([shop, isDeleted])
}

// Each individual field change on a product
model ChangeEvent {
  id              Int       @id @default(autoincrement())
  shop            String    @db.VarChar(255)
  productId       String    @db.VarChar(255)
  productTitle    String    @db.VarChar(500)
  fieldName       String    @db.VarChar(255)  // e.g. "price", "title", "status"
  variantId       String?   @db.VarChar(255)  // for variant-level changes
  oldValue        String?   @db.LongText
  newValue        String?   @db.LongText
  changedAt       DateTime  @default(now())
  incidentId      Int?
  incident        Incident? @relation(fields: [incidentId], references: [id])

  @@index([shop])
  @@index([productId])
  @@index([changedAt])
  @@index([incidentId])
}

// Grouped suspicious/bulk changes
model Incident {
  id              Int       @id @default(autoincrement())
  shop            String    @db.VarChar(255)
  name            String    @db.VarChar(500)
  severity        String    @db.VarChar(50)  // LOW, MEDIUM, HIGH, CRITICAL
  status          String    @db.VarChar(50)  @default("OPEN") // OPEN, RESOLVED, IGNORED, ROLLED_BACK
  affectedCount   Int       @default(0)
  triggeredRuleId Int?
  triggeredRule   DetectionRule? @relation(fields: [triggeredRuleId], references: [id])
  changes         ChangeEvent[]
  rollbackJobs    RollbackJob[]
  createdAt       DateTime  @default(now())
  resolvedAt      DateTime?
  notes           String?   @db.Text

  @@index([shop])
  @@index([status])
  @@index([createdAt])
}

// Detection rules for suspicious changes
model DetectionRule {
  id              Int       @id @default(autoincrement())
  shop            String    @db.VarChar(255)
  name            String    @db.VarChar(255)
  isActive        Boolean   @default(true)
  field           String    @db.VarChar(100)   // price, title, status, etc.
  condition       String    @db.VarChar(100)   // DECREASE_BY_PERCENT, INCREASE_BY_PERCENT, CHANGED
  threshold       Float?                        // e.g. 30 for 30%
  minProducts     Int?                          // minimum affected products
  windowMinutes   Int?      @default(10)        // time window in minutes
  severity        String    @db.VarChar(50)    @default("HIGH")
  incidents       Incident[]
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt

  @@index([shop, isActive])
}

// Rollback jobs (may cover multiple products)
model RollbackJob {
  id              Int       @id @default(autoincrement())
  shop            String    @db.VarChar(255)
  incidentId      Int?
  incident        Incident? @relation(fields: [incidentId], references: [id])
  restorePointId  Int?
  restorePoint    RestorePoint? @relation(fields: [restorePointId], references: [id])
  status          String    @db.VarChar(50)  @default("PENDING") // PENDING, RUNNING, COMPLETED, FAILED, PARTIAL
  totalProducts   Int       @default(0)
  processedCount  Int       @default(0)
  successCount    Int       @default(0)
  failedCount     Int       @default(0)
  fieldsToRestore Json?     // which fields to restore
  createdAt       DateTime  @default(now())
  completedAt     DateTime?
  results         RollbackResult[]

  @@index([shop])
  @@index([status])
}

// Per-product result of a rollback job
model RollbackResult {
  id              Int         @id @default(autoincrement())
  rollbackJobId   Int
  rollbackJob     RollbackJob @relation(fields: [rollbackJobId], references: [id])
  productId       String      @db.VarChar(255)
  productTitle    String      @db.VarChar(500)
  status          String      @db.VarChar(50)  // SUCCESS, FAILED, SKIPPED
  errorMessage    String?     @db.Text
  restoredFields  Json?       // fields actually restored
  createdAt       DateTime    @default(now())

  @@index([rollbackJobId])
}

// Merchant-created restore points (manual snapshots)
model RestorePoint {
  id              Int       @id @default(autoincrement())
  shop            String    @db.VarChar(255)
  name            String    @db.VarChar(500)
  description     String?   @db.Text
  productCount    Int       @default(0)
  themeCount      Int       @default(0)
  collectionCount Int       @default(0)
  pageCount       Int       @default(0)
  menuCount       Int       @default(0)
  articleCount    Int       @default(0)
  metafieldCount  Int       @default(0)
  orderCount      Int       @default(0)
  customerCount   Int       @default(0)
  status          String    @db.VarChar(50)  @default("CREATING") // CREATING, READY, RESTORING
  backupType      String    @default("FULL") @db.VarChar(50)      // FULL, PRODUCTS, THEMES, COLLECTIONS, PAGES, BLOGS, MENUS, METAFIELDS, VAULT
  // Who created it. MANUAL (including imports) is never deleted to make room;
  // the automatic sources rotate out oldest-first to keep a store within its
  // plan's restore-point allowance (backup.server.js, reserveRestorePointSlot).
  source          String    @default("MANUAL") @db.VarChar(20)    // MANUAL, SCHEDULED, THEME_PUBLISH, BASELINE, PRE_RESTORE
  snapshotData    Json?     // array of product snapshots
  themeData       Json?     // active theme metadata & critical file contents
  collectionData  Json?     // array of collections & ruleSets
  pageData        Json?     // array of pages
  menuData        Json?     // array of navigation menus
  articleData     Json?     // array of blogs & articles
  metafieldData   Json?     // { definitions, owners, counts } — revertly-metafields-v1
  orderData       Json?     // array/snapshot of orders
  customerData    Json?     // array/snapshot of customers
  cloudSyncedAt   DateTime?
  cloudSyncStatus String    @default("NOT_SYNCED") @db.VarChar(50) // NOT_SYNCED, SYNCED, PENDING, FAILED
  cloudProvider   String?   @db.VarChar(50)                        // GOOGLE_DRIVE, DROPBOX
  rollbackJobs    RollbackJob[]
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt

  @@index([shop])
  @@index([shop, createdAt])
  @@index([shop, status, createdAt])
}

// Historical Orders Vault for Tax & Chargeback Protection
model OrderArchive {
  id                Int      @id @default(autoincrement())
  shop              String   @db.VarChar(255)
  orderId           String   @db.VarChar(255)
  orderNumber       String   @db.VarChar(100)
  customerEmail     String?  @db.VarChar(255)
  customerName      String?  @db.VarChar(255)
  totalPrice        String   @db.VarChar(50)
  currency          String   @default("USD") @db.VarChar(10)
  financialStatus   String?  @db.VarChar(50)
  fulfillmentStatus String?  @db.VarChar(50)
  processedAt       DateTime?
  orderData         Json
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt

  @@unique([shop, orderId])
  @@index([shop, orderNumber])
  @@index([shop, customerEmail])
  @@index([shop, processedAt])
}

// Customers Archive for Contact & Profile Security
model CustomerArchive {
  id              Int      @id @default(autoincrement())
  shop            String   @db.VarChar(255)
  customerId      String   @db.VarChar(255)
  email           String?  @db.VarChar(255)
  firstName       String?  @db.VarChar(255)
  lastName        String?  @db.VarChar(255)
  phone           String?  @db.VarChar(100)
  ordersCount     Int      @default(0)
  totalSpent      String?  @db.VarChar(50)
  customerData    Json
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  @@unique([shop, customerId])
  @@index([shop, email])
}

// App-level settings per shop
model AppSettings {
  id                  Int     @id @default(autoincrement())
  shop                String  @unique @db.VarChar(255)
  alertEmail          String? @db.VarChar(255)
  alertOnCritical     Boolean @default(true)
  alertOnHigh         Boolean @default(true)
  alertOnMedium       Boolean @default(false)
  alertOnLow          Boolean @default(false)
  monitoringEnabled   Boolean @default(true)
  bulkThreshold       Int     @default(20)   // products changed to trigger bulk detection
  bulkWindowMinutes   Int     @default(10)
  planId              String   @default("free") @db.VarChar(50)
  subscriptionId      String?  @db.VarChar(255)
  billingInterval     String?  @default("EVERY_30_DAYS") @db.VarChar(50)
  hasUsedTrial        Boolean  @default(false)
  trialEndsAt         DateTime?
  productLimitReachedAt DateTime?
  // Shopify Partner development store. Refreshed on every token exchange
  // (shopify.server.js afterAuth) and on each Plans & Billing load, so the
  // entitlement gates — which run without an admin client — can grant the
  // free Growth access the Plans page promises these stores.
  isPartnerDevelopment  Boolean  @default(false)
  slackWebhookUrl       String?  @db.VarChar(500)
  circuitBreakerEnabled Boolean  @default(false)
  circuitBreakerThreshold Int    @default(50)   // percentage drop (e.g. 50%)
  circuitBreakerAction  String   @default("DRAFT") @db.VarChar(50) // DRAFT or AUTO_REVERT
  autoBackupSchedule    String   @default("DAILY") @db.VarChar(50) // DAILY, TWICE_DAILY, WEEKLY, OFF
  autoBackupTime        String   @default("02:00") @db.VarChar(10) // Preferred UTC time
  lastAutoBackupAt      DateTime?
  nextAutoBackupAt      DateTime?
  cloudSyncProvider     String   @default("NONE") @db.VarChar(50)  // NONE, GOOGLE_DRIVE, DROPBOX
  cloudSyncEmail        String?  @db.VarChar(255)
  cloudSyncConnected    Boolean  @default(false)
  cloudSyncFolder       String   @default("Revertly_Backups") @db.VarChar(255)
  cloudSyncAutoUpload   Boolean  @default(false)
  cloudSyncAccessToken  String?  @db.Text
  cloudSyncRefreshToken String?  @db.Text
  cloudSyncTokenExpiry  DateTime?
  // Email marketing (ESP) backup. Klaviyo uses a single private API key;
  // Mailchimp keys carry their datacenter as a "-usX" suffix, which becomes
  // the API host, so it is stored alongside rather than re-parsed per call.
  klaviyoConnected      Boolean  @default(false)
  klaviyoApiKey         String?  @db.Text
  klaviyoAccountName    String?  @db.VarChar(255)
  mailchimpConnected    Boolean  @default(false)
  mailchimpApiKey       String?  @db.Text
  mailchimpServerPrefix String?  @db.VarChar(20)
  mailchimpAccountName  String?  @db.VarChar(255)
  marketingAutoBackup   Boolean  @default(false)
  lastMarketingBackupAt DateTime?
  customProductLimit    Int?     // Admin-assigned custom product limit (e.g. 350000, 500000)
  customPlanNote        String?  @db.VarChar(500) // Internal note (e.g. "$249/mo custom deal approved via email")
  customPriceAmount     Int?     // Custom monthly price in USD (e.g. 199, 249, 299)
  customBillingMethod   String?  @default("SHOPIFY") @db.VarChar(50) // SHOPIFY or EXTERNAL
  customPriceStatus     String?  @db.VarChar(50) // OFFERED, ACTIVE, CANCELLED
  // GA4 / Google Tag Manager tag health (ga4Monitor.server.js). All optional:
  // a null status means the store has never been checked. IDs keep the last
  // detected value through MISSING/UNKNOWN checks so an alert can name the tag
  // that disappeared. ga4AlertedAt vs ga4LastDetectedAt is what limits alerts
  // to one per loss.
  ga4Status             String?  @db.VarChar(20)  // DETECTED, MISSING, UNKNOWN
  ga4MeasurementId      String?  @db.VarChar(255) // last detected G- IDs, comma-separated
  gtmContainerId        String?  @db.VarChar(255) // last detected GTM- IDs, comma-separated
  ga4DetectedIn         String?  @db.VarChar(20)  // STOREFRONT, THEME, BOTH
  ga4StatusDetail       String?  @db.VarChar(500)
  ga4LastCheckedAt      DateTime?
  ga4LastDetectedAt     DateTime? // last time a tag was seen on the LIVE storefront
  ga4AlertedAt          DateTime?
  ga4NextCheckAt        DateTime?
  createdAt           DateTime @default(now())
  updatedAt           DateTime @updatedAt
}

// ── Email marketing backup ──────────────────────────────────────────────────
//
// One row per captured ESP object, scoped by (shop, provider, remote id) so a
// store can hold Klaviyo and Mailchimp side by side and a re-run updates in
// place rather than duplicating. `provider` is KLAVIYO | MAILCHIMP.
//
// The raw payload is kept in the *Data Json column so a restore can replay
// fields this schema does not model, exactly as ProductSnapshot and
// OrderArchive do for Shopify resources.

// A Klaviyo list/segment or a Mailchimp audience/segment.
model MarketingList {
  id           Int      @id @default(autoincrement())
  shop         String   @db.VarChar(255)
  provider     String   @db.VarChar(20)
  listId       String   @db.VarChar(255)
  name         String   @db.VarChar(500)
  listType     String   @default("LIST") @db.VarChar(20) // LIST | SEGMENT
  memberCount  Int      @default(0)
  listData     Json
  capturedAt   DateTime @default(now())
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  @@unique([shop, provider, listId])
  @@index([shop, provider])
  @@index([shop, listType])
}

// A subscriber profile. Counts against the plan's marketingProfiles cap.
model MarketingProfile {
  id           Int      @id @default(autoincrement())
  shop         String   @db.VarChar(255)
  provider     String   @db.VarChar(20)
  profileId    String   @db.VarChar(255)
  email        String?  @db.VarChar(255)
  firstName    String?  @db.VarChar(255)
  lastName     String?  @db.VarChar(255)
  phone        String?  @db.VarChar(100)
  status       String?  @db.VarChar(50) // subscribed | unsubscribed | cleaned ...
  listIds      Json?
  profileData  Json
  capturedAt   DateTime @default(now())
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  @@unique([shop, provider, profileId])
  @@index([shop, provider])
  @@index([shop, email])
}

// A Klaviyo flow or a Mailchimp journey/automation. Business and above only
// (the marketingFlows entitlement), because this is automation logic rather
// than contact records.
model MarketingFlow {
  id           Int      @id @default(autoincrement())
  shop         String   @db.VarChar(255)
  provider     String   @db.VarChar(20)
  flowId       String   @db.VarChar(255)
  name         String   @db.VarChar(500)
  status       String?  @db.VarChar(50)
  triggerType  String?  @db.VarChar(100)
  flowData     Json
  capturedAt   DateTime @default(now())
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  @@unique([shop, provider, flowId])
  @@index([shop, provider])
}

// A platform-admin-granted discount on a single merchant's subscription.
// Always "yearly": every set/update pushes expiresAt to one year out, and the
// checkout-time Shopify discount is applied for 12 billing intervals to match.
// `tier` is a label on the same grant, not a second discount: a store has at
// most one store-level discount, which is either STANDARD or VIP.
//
// STANDARD applies as soon as it is granted. VIP is an *offer* the merchant
// must accept: it discounts nothing until they claim it, and `expiresAt` is
// recomputed from the claim date so the merchant gets a full year from the day
// they actually take it up.
model StoreDiscount {
  id               Int       @id @default(autoincrement())
  shop             String    @unique @db.VarChar(255)
  tier             String    @default("STANDARD") @db.VarChar(20) // STANDARD | VIP
  discountPercent  Int // 1-100
  note             String?   @db.VarChar(500)
  isActive         Boolean   @default(true)
  claimedAt        DateTime? // VIP only: null means the offer is still unclaimed
  expiresAt        DateTime
  createdByEmail   String?   @db.VarChar(255)
  updatedByEmail   String?   @db.VarChar(255)
  createdAt        DateTime  @default(now())
  updatedAt        DateTime  @updatedAt

  @@index([shop, isActive])
}

// Single-row table (id is always 1) holding platform-wide operator settings:
// the global yearly discount offered to every store, and the free-Growth
// promotion's configuration.
model PlatformSettings {
  id                      Int       @id @default(1)
  globalDiscountPercent   Int? // 1-100; null when no global discount is set
  globalDiscountNote      String?   @db.VarChar(500)
  globalDiscountActive    Boolean   @default(false)
  globalDiscountExpiresAt DateTime?
  freeGrowthEnabled       Boolean   @default(true)
  freeGrowthSeatLimit     Int       @default(20)
  freeGrowthDurationMonths Int      @default(2)
  updatedByEmail          String?   @db.VarChar(255)
  createdAt               DateTime  @default(now())
  updatedAt               DateTime  @updatedAt
}

// A seat in the "Growth plan free for the first N stores" promotion.
// Seats are released when a store uninstalls (the row is deleted), so the
// count always reflects currently-installed stores and the next installer
// takes the freed seat.
model FreeGrowthGrant {
  id        Int      @id @default(autoincrement())
  shop      String   @unique @db.VarChar(255)
  expiresAt DateTime
  grantedAt DateTime @default(now())

  @@index([expiresAt])
}

// Support tickets submitted by merchants
model SupportTicket {
  id          Int      @id @default(autoincrement())
  shop        String   @db.VarChar(255)
  subject     String   @db.VarChar(500)
  category    String   @db.VarChar(100) @default("General")
  message     String   @db.LongText
  email       String?  @db.VarChar(255)
  status      String   @db.VarChar(50)  @default("OPEN") // OPEN, IN_PROGRESS, RESOLVED, CLOSED
  priority    String   @default("NORMAL") @db.VarChar(50)  // NORMAL, HIGH, URGENT
  planTier    String?  @db.VarChar(50)
  isEmergency Boolean  @default(false)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([shop])
  @@index([status])
}

// Multi-user team members with role-based access control (RBAC)
model TeamMember {
  id            Int       @id @default(autoincrement())
  shop          String    @db.VarChar(255)
  email         String    @db.VarChar(255)
  name          String?   @db.VarChar(255)
  role          String    @default("ADMIN") @db.VarChar(50) // OWNER, ADMIN, EDITOR, VIEWER
  status        String    @default("ACTIVE") @db.VarChar(50) // ACTIVE, INVITED, SUSPENDED
  alertsEnabled Boolean   @default(true)
  lastActiveAt  DateTime?
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  @@unique([shop, email])
  @@index([shop])
}

// Multi-user and system security audit trail
model AuditLog {
  id           Int      @id @default(autoincrement())
  shop         String   @db.VarChar(255)
  userEmail    String?  @db.VarChar(255)
  userName     String?  @db.VarChar(255)
  action       String   @db.VarChar(100) // RESTORE_TRIGGERED, BACKUP_CREATED, SETTINGS_UPDATED, etc.
  resourceType String?  @db.VarChar(100)
  resourceId   String?  @db.VarChar(255)
  details      Json?
  ipAddress    String?  @db.VarChar(100)
  createdAt    DateTime @default(now())

  @@index([shop])
  @@index([shop, action])
  @@index([createdAt])
}

// Store & third-party app downtime monitoring services
model MonitoredService {
  id                    Int             @id @default(autoincrement())
  shop                  String          @db.VarChar(255)
  name                  String          @db.VarChar(255)
  serviceType           String          @default("STOREFRONT") @db.VarChar(50) // STOREFRONT, SHOPIFY_API, APP, CUSTOM
  url                   String          @db.VarChar(500)
  status                String          @default("OPERATIONAL") @db.VarChar(50) // OPERATIONAL, DEGRADED, DOWN
  uptimePercent         Float           @default(100.0)
  lastResponseTimeMs    Int?
  lastStatusCode        Int?
  lastCheckAt           DateTime?
  checkIntervalMinutes  Int             @default(5)
  checks                DowntimeCheck[]
  createdAt             DateTime        @default(now())
  updatedAt             DateTime        @updatedAt

  @@index([shop])
  @@index([status])
}

// Individual periodic ping/check results for monitored services
model DowntimeCheck {
  id             Int              @id @default(autoincrement())
  shop           String           @db.VarChar(255)
  serviceId      Int
  service        MonitoredService @relation(fields: [serviceId], references: [id], onDelete: Cascade)
  isUp           Boolean          @default(true)
  statusCode     Int?
  responseTimeMs Int?
  errorMessage   String?          @db.Text
  checkedAt      DateTime         @default(now())

  @@index([shop])
  @@index([serviceId])
  @@index([checkedAt])
}

// In-app automated QA and backup integrity diagnostic runs
model QaTestRun {
  id          Int      @id @default(autoincrement())
  shop        String   @db.VarChar(255)
  healthScore Int      @default(100) // 0 - 100
  status      String   @default("PASSED") @db.VarChar(50) // PASSED, WARNING, FAILED
  summary     String?  @db.Text
  testResults Json
  testedAt    DateTime @default(now())

  @@index([shop])
  @@index([testedAt])
}

// Distributed lock so scheduled sweeps don't double-fire across server instances.
// A lock is held until `expiresAt`; acquisition is an atomic conditional update on
// that column, so a crashed holder self-heals once the TTL lapses.
model JobLock {
  id        Int      @id @default(autoincrement())
  name      String   @unique @db.VarChar(191)
  owner     String?  @db.VarChar(191) // instance identifier, for diagnostics
  lockedAt  DateTime @default(now())
  expiresAt DateTime

  @@index([expiresAt])
}

// Background catalog sync jobs for high-volume stores (30,000+ products)
// Tracks asynchronous batched synchronization progress, cursors, and memory isolation.
model CatalogSyncJob {
  id             Int       @id @default(autoincrement())
  shop           String    @db.VarChar(255)
  status         String    @default("PENDING") @db.VarChar(50) // PENDING, PROCESSING, COMPLETED, FAILED, CANCELLED
  totalEstimated Int       @default(0)
  processedCount Int       @default(0)
  currentCursor  String?   @db.Text
  batchSize      Int       @default(50)
  errorMessage   String?   @db.Text
  startedAt      DateTime  @default(now())
  completedAt    DateTime?
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt

  @@index([shop, status])
  @@index([shop, createdAt])
}

